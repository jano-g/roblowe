# ---------------------------------------------------------------------------
# Roblowe – obchodný agent. Skopíruj na .env (chmod 600) a vyplň. .env je v .gitignore.
# ---------------------------------------------------------------------------

# Verejná URL appky. Bez lomky na konci.
APP_URL=https://roblowe.gordulic.sk

# Port na serveri (HTTP, iba localhost). nginx robí HTTPS. Musí sedieť s nginx vhostom.
APP_PORT=8120
APP_BIND=127.0.0.1
APP_TZ=Europe/Bratislava

# Prihlásenie do dashboardu. Heslo aspoň 8 znakov, použije sa LEN pri prvom štarte (prázdna DB).
# Zabudnuté heslo: docker compose exec roblowe python -m app.cli set-password jano
ADMIN_USERNAME=jano
ADMIN_PASSWORD=zmen-ma-aspon-8-znakov

# Podpisový kľúč cookies. Prázdne = vygeneruje sa raz do /data/secret.key. openssl rand -hex 32
SECRET_KEY=

# --- Obchodovanie ------------------------------------------------------------
# Režim a API kľúče sa nastavujú V APPKE: Nastavenia → Broker a kľúče (vyžaduje heslo,
# live navyše napísať LIVE). Hodnoty nižšie sú len počiatočné; čo uložíš v appke, vyhráva.
# dry   = rozhoduje a loguje, na burzu NEPOSIELA nič (s paper kľúčmi používa reálne dáta)
# paper = Alpaca paper účet (fiktívne peniaze) – tu začni a nechaj to bežať aspoň 4–8 týždňov
# live  = skutočné peniaze
TRADING_MODE=dry

# Alpaca kľúče (https://app.alpaca.markets → API Keys). Paper a live účet majú RÔZNE kľúče.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# iex = bezplatné dáta (stačia), sip = platený Algo Trader Plus
ALPACA_FEED=iex

# Claude (analýza správ). Prázdne = agent beží len na technických signáloch.
ANTHROPIC_API_KEY=

# --- Nasledujúce sa dajú meniť aj v appke (Nastavenia); DB vyhráva nad .env ---
AGENT_ENABLED=0
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD
CYCLE_MINUTES=5
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=10
MAX_POSITIONS=4
DAILY_LOSS_LIMIT_PCT=2
FLATTEN_BEFORE_CLOSE_MIN=10
ANALYST_MODEL=claude-opus-5
ANALYST_EFFORT=medium
ANALYST_DAILY_BUDGET_CALLS=60

# Push notifikácie (ntfy.sh). Téma si vymysli dlhú a náhodnú, funguje ako heslo.
# NOTIFY_MODE: trade = každý obchod, daily = jeden súhrn po zatvorení burzy, both = oboje
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NOTIFY_MODE=both

# Backblaze B2 – zálohy databázy. Kľúč obmedz na jeden privátny bucket.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_PREFIX=roblowe/
BACKUP_TIME=03:30
BACKUP_KEEP=14
BACKUP_ENABLED=1
